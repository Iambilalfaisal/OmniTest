# /backend/.env

# AI Model Provider
GOOGLE_API_KEY="<your-gemini-api-key>"
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# Model identifiers — required, no in-code default. Set these to actual Gemini model
# ids you have access to before running; the app fails fast at startup if unset.
PLANNER_MODEL="<set-your-gemini-model-id>"
WORKER_MODEL="<set-your-gemini-model-id>"
# Falls back to WORKER_MODEL if unset (core/llm.py's ModelRole.VERDICT resolution) —
# set separately to give verdict_node its own quota bucket from the worker's hot loop.
VERDICT_MODEL="<set-your-gemini-model-id>"
MEMORY_EXTRACTION_MODEL="<set-your-gemini-model-id>"
MEMORY_EMBEDDING_MODEL="<set-your-gemini-embedding-model-id>"
# Must match MEMORY_EMBEDDING_MODEL's output width — e.g. Gemini's text-embedding-004
# outputs 768 dims; gemini-embedding-001 supports configurable output up to 3072.
MEMORY_EMBEDDING_DIMS="<set-to-match-MEMORY_EMBEDDING_MODEL's-output-width>"

# API Configuration
PORT=8000
HOST="0.0.0.0"
# floor(RPM_limit / requests_per_worker_per_minute) for WORKER_MODEL — see backend/.env
# for the worked example this default came from. Re-derive from your own AI Studio
# rate-limit page and summary.llm.requests (Stage 0.5) rather than trusting this as-is.
MAX_CONCURRENT_WORKERS=4
SSE_POLL_INTERVAL_SECONDS=1.0

# Chat-first discovery planning (backend/nodes/discovery.py, backend/nodes/planner_explore.py)
# — the shallow site crawl run before proposing a test plan, and the bounds on the
# discovery conversation itself. Discovery reuses PLANNER_MODEL rather than a separate
# required model var, since the chat conversation IS the planner for a chat-approved run.
PLANNER_CRAWL_MAX_PAGES=8
PLANNER_CRAWL_MAX_DEPTH=2
SITE_MAP_TTL_HOURS=24
MAX_DISCOVERY_TURNS=20
MAX_EXTRA_DIVES=5

# History dashboard (backend/core/history.py) — session-history metadata store backing
# GET /history and /history/stats. Its own dedicated connection pool, separate from the
# checkpointer's single-connection bottleneck, since history writes on every run's status
# transition must never contend with checkpoint I/O.
HISTORY_POOL_MAX_SIZE=5

# Postgres — checkpointing (fault tolerance / HITL pause-resume) and long-term memory
# (pgvector) share this same database, just different tables. host/port/user below
# match a default local Postgres install (localhost:5432, user "postgres") — fill in
# <db-password> and <db-name> for your instance. If pointing this at a database
# already named with mixed case (e.g. "OmniTest" in pgAdmin), use that exact case
# here — Postgres treats a quoted/pgAdmin-created name as case-sensitive. Requires
# the pgvector extension enabled on it: `CREATE EXTENSION IF NOT EXISTS vector;`
DATABASE_URL="postgresql://postgres:<db-password>@localhost:5432/<db-name>"

# LangSmith Tracing (Highly recommended for debugging LangGraph)
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="ls__..."
LANGCHAIN_PROJECT="OmniTest-Dev"

# Playwright MCP server (defaults shown below are used if unset). --isolated is
# required for our concurrent-worker design, not optional; --headless keeps every
# automated browser invisible to whoever is running this (it otherwise pops a real,
# visible window on the desktop by default). Devtools (trace/video capture) and storage
# (Stage 3 shared login, nodes/auth_setup.py) capabilities are NOT set here — mcp/client.py
# appends --config=<bundled playwright-mcp-config.json> itself, since the installed
# @playwright/mcp can't combine multiple --caps values in one CLI arg (confirmed bug,
# see mcp/client.py). Add other flags here if needed, just don't put --caps back on
# this line.
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_ARGS=-y @playwright/mcp@latest --isolated --headless
