# /backend/.env

# AI Model Provider
OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."

# Model identifiers — required, no in-code default. Set these to actual model ids
# you have access to before running; the app fails fast at startup if unset.
PLANNER_MODEL="<set-your-openai-model-id>"
WORKER_MODEL="<set-your-openai-model-id>"
MEMORY_EXTRACTION_MODEL="<set-your-openai-model-id>"
MEMORY_EMBEDDING_MODEL="<set-your-openai-embedding-model-id>"
MEMORY_EMBEDDING_DIMS="<set-to-match-MEMORY_EMBEDDING_MODEL's-output-width>"

# API Configuration
PORT=8000
HOST="0.0.0.0"
MAX_CONCURRENT_WORKERS=4
SSE_POLL_INTERVAL_SECONDS=1.0

# Postgres — checkpointing (fault tolerance / HITL pause-resume) and long-term
# memory (pgvector) share this same database, just different tables. host/port/user
# below match a default local Postgres install (localhost:5432, user "postgres") —
# fill in <db-password> and <db-name> for your instance. If you're pointing this at
# a database already named with mixed case (e.g. "OmniTest" in pgAdmin), use that
# exact case here — Postgres treats a quoted/pgAdmin-created name as case-sensitive.
# Enable pgvector on it once: `CREATE EXTENSION IF NOT EXISTS vector;` (on Windows
# this may need a manual pgvector install if your Postgres build doesn't bundle it).
DATABASE_URL="postgresql://postgres:<db-password>@localhost:5432/<db-name>"

# LangSmith Tracing (Highly recommended for debugging LangGraph)
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="ls__..."
LANGCHAIN_PROJECT="OmniTest-Dev"

# Playwright MCP server (defaults shown below are used if unset). --isolated is
# required for our concurrent-worker design, not optional — see mcp/client.py.
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_ARGS=-y @playwright/mcp@latest --isolated
